# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/meeting-assistant

# Groq LLM API key — obtain from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# JWT signing secret — use a long random string in production
# Example: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ── Optional ──────────────────────────────────────────────────────────────────
# HTTP port (default: 4000)
PORT=4000

# Allowed CORS origin for the frontend (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# SMTP Configuration — leave blank to disable email sharing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
